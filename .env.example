# Copy this file to .env and fill in your real values before running the
# app locally:
#
#   cp .env.example .env
#
# .env is git-ignored -- never commit your real key. In a Docker/Portainer
# deployment, do not bake these into the image either: set them as
# environment variables in Portainer's "Env" tab at deploy time instead
# (see README.md -> Deploying section).

# Required. Despite the name, this is your OPENROUTER key
# (https://openrouter.ai/keys), NOT a Google AI Studio key -- the model is
# routed through OpenRouter. See src/llm/gemini_client.py for why.
GEMINI_API_KEY=

# Optional -- Dash bind address/port. Leave unset for local development
# (defaults to 127.0.0.1:8050). The Dockerfile sets these explicitly for
# container deployment, so you normally don't need to touch them yourself.
DASH_HOST=127.0.0.1
DASH_PORT=8050

# Optional -- set to 1 to show Dash's developer toolbar while developing.
# Leave at 0 (or unset) for anything client- or demo-facing.
DASH_DEBUG=0

# Optional -- set to 1 to skip auto-opening a browser tab on startup
# (useful when running headless, e.g. inside Docker).
DASH_NO_BROWSER=0

# Optional -- logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
